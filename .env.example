# --- Owner dashboard ---
# Password for the /owner dashboard
OWNER_PASSWORD=natalie2026
# Secret used to sign the session cookie (set to any random string)
SESSION_SECRET=change-me-to-a-random-string

# --- Database (required) ---
# Any Postgres connection string. On Vercel, add Neon from the Marketplace and
# this gets set automatically. For local dev, point at a local or Neon dev DB.
DATABASE_URL=postgres://user:password@host/dbname

# --- Email notifications (optional) ---
# Resend credentials — if unset, the app logs instead of emailing.
RESEND_API_KEY=
# Verified sender, e.g. "Natalie's Swim Lessons <bookings@yourdomain.com>"
EMAIL_FROM=
# Natalie's email — receives a message whenever a lesson is booked.
OWNER_EMAIL=
